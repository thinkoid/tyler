#!/bin/sh
# tyler-status -- volume / wifi / cpu / temp / battery / date for tyler's
# bar; sibling of kwm-status. Two transports, one per tyler:
#   default  tyler-classic (X11): each cycle sets WM_NAME on the root --
#            via xprop, since xsetroot is not installed.
#   -o       wayland tyler: one line per cycle on stdout; the compositor
#            spawns us and reads the pipe.
# Plain text throughout: the bar draws no color escapes.
#
# Either transport ends the loop when its session dies -- xprop fails
# without the X server, the pipe breaks without the compositor -- so a
# stale loop never survives into the next session.
#
# The fleet is not one machine: Intel laptops expose coretemp and a BAT0,
# AMD desktops expose k10temp and no battery at all, and the Snapdragon
# laptop a battery under another name with no percentage file. All of
# it is discovered once at startup (see below) and a field that has no
# source is simply not drawn, rather than printing an error every five
# seconds. Wire ~/.local/bin/tyler-status as a symlink here; the repo
# is the truth.

# Nerd-font icons (the bar font is IosevkaTerm Nerd Font): volume,
# wifi, cpu chip, thermometer, battery ladder full->empty, bolt.
I_VOL=$(printf '\357\200\250')
I_NET=$(printf '\357\207\253')
I_CPU=$(printf '\357\213\233')
I_TMP=$(printf '\357\213\211')
I_B4=$(printf '\357\211\200') I_B3=$(printf '\357\211\201')
I_B2=$(printf '\357\211\202') I_B1=$(printf '\357\211\203')
I_B0=$(printf '\357\211\204')
I_CHG=$(printf '\357\203\247')
DEG=$(printf '\302\260')

out=xprop
[ "$1" = "-o" ] && out=stdout

# Color escapes, kwm's grammar and solarized accents: ^#RRGGBBAA sets,
# ^#! restores the bar default. Only the wayland bar parses them, so
# they exist only on the stdout transport -- the X bar draws plain.
C_VOL= C_NET= C_CPU= C_TMP= C_BAT= C_CHG= C_RED= NRM=
if [ stdout = "$out" ]; then
    C_VOL="^#268bd2ff" C_NET="^#2aa198ff" C_CPU="^#859900ff"
    C_TMP="^#cb4b16ff" C_BAT="^#b58900ff" C_CHG="^#859900ff"
    C_RED="^#dc322fff" NRM="^#!"
fi

prev_total=0 prev_idle=0

# Hardware discovery, once: none of this changes while the session runs,
# and probing it every cycle would only multiply the failure. An empty
# variable is the signal that the field has no source on this machine --
# the printf at the bottom drops the segment entirely rather than drawing
# a placeholder for a sensor that does not exist.
#
# coretemp keeps a fixed platform path; k10temp does not, so fall back to
# walking the hwmon class and matching on name. The Snapdragon laptop has
# neither: its sensors are thermal zones, two per core, typed
# cpuN-M-top-thermal and cpuN-M-btm-thermal, and the number worth showing
# is the hottest of them. temp_input names one file; temp_zones names a
# set, read as a max each cycle. At most one of the two is set.
temp_input=$(ls /sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input 2>/dev/null | head -1)
if [ -z "$temp_input" ]; then
    for h in /sys/class/hwmon/hwmon*; do
        case $(cat "$h/name" 2>/dev/null) in
            coretemp|k10temp) temp_input="$h/temp1_input"; break ;;
        esac
    done
fi
[ -r "$temp_input" ] || temp_input=
temp_zones=
if [ -z "$temp_input" ]; then
    for z in /sys/class/thermal/thermal_zone*; do
        case $(cat "$z/type" 2>/dev/null) in
            cpu*-thermal) temp_zones="$temp_zones $z/temp" ;;
        esac
    done
fi

# Millidegrees: the one file, or the hottest of the zone set.
temp_read() {
    if [ -n "$temp_input" ]; then
        cat "$temp_input"
    else
        cat $temp_zones 2>/dev/null | sort -n | tail -1
    fi
}

# The battery's name is not fixed either -- BAT0 under ACPI, qcom-battmgr-bat
# on the Snapdragon laptop -- so match on type. A peripheral's battery (a
# Bluetooth keyboard's, via HID) is type Battery too but announces
# scope=Device; skip those. Nor is the percentage guaranteed: qcom_battmgr's
# X1E80100 property table omits capacity, so fall back to energy_now over
# energy_full (or the charge pair), which is how the ACPI driver produces
# capacity in the first place. bat_src names the file pair the percentage
# comes from.
battery= bat_src=
for p in /sys/class/power_supply/*; do
    [ "$(cat "$p/type" 2>/dev/null)" = Battery ] || continue
    [ "$(cat "$p/scope" 2>/dev/null)" = Device ] && continue
    if   [ -r "$p/capacity" ];                            then bat_src=capacity
    elif [ -r "$p/energy_now" ] && [ -r "$p/energy_full" ]; then bat_src=energy
    elif [ -r "$p/charge_now" ] && [ -r "$p/charge_full" ]; then bat_src=charge
    else continue
    fi
    battery=$p
    break
done

# Percentage, or nothing when the driver has no answer this cycle (the
# firmware-backed ones return ENODATA before the service is up). The
# divisor is scaled down first: 100 * energy_now overflows 32 bits on a
# 55 Wh pack, and the shell's arithmetic width is not something to lean on.
bat_pct() {
    if [ capacity = "$bat_src" ]; then
        cat "$battery/capacity" 2>/dev/null
        return
    fi
    now=$(cat "$battery/${bat_src}_now" 2>/dev/null) || return
    full=$(cat "$battery/${bat_src}_full" 2>/dev/null) || return
    [ "${full:-0}" -gt 0 ] || return
    pct=$((now / (full / 100)))
    [ "$pct" -gt 100 ] && pct=100
    echo "$pct"
}

# Busy% between two /proc/stat samples (the sleep is the sample gap, so
# the first line after startup reads 100% for an instant and settles).
cpu_pct() {
    set -- $(head -1 /proc/stat)
    shift
    total=$(($1 + $2 + $3 + $4 + $5 + $6 + $7 + $8))
    idle=$(($4 + $5))
    d_total=$((total - prev_total)) d_idle=$((idle - prev_idle))
    prev_total=$total prev_idle=$idle
    if [ "$d_total" -gt 0 ]; then
        echo $((100 * (d_total - d_idle) / d_total))
    else
        echo 0
    fi
}

while :; do
    cpu=$(cpu_pct)

    tmp=
    if [ -n "$temp_input$temp_zones" ]; then
        t=$(temp_read)
        [ -n "$t" ] && tmp="${C_TMP}${I_TMP}${NRM}  $((t / 1000))${DEG}C"
    fi

    bat=
    cap=
    [ -n "$battery" ] && cap=$(bat_pct)
    if [ -n "$cap" ]; then
        if   [ "$cap" -ge 90 ]; then bicon=$I_B4
        elif [ "$cap" -ge 65 ]; then bicon=$I_B3
        elif [ "$cap" -ge 40 ]; then bicon=$I_B2
        elif [ "$cap" -ge 15 ]; then bicon=$I_B1
        else                         bicon=$I_B0
        fi
        cbat=$C_BAT
        [ "$cap" -lt 15 ] && cbat=$C_RED

        case $(cat "$battery/status") in
            Charging) bat="${C_CHG}${I_CHG}${NRM}  ${cap}%" ;;
            *)        bat="${cbat}${bicon}${NRM}  ${cap}%" ;;
        esac
    fi

    # iw, not iwgetid: wireless_tools is not installed fleet-wide, iw is.
    ssid=$(iw dev wlan0 info 2>/dev/null |
               awk '$1 == "ssid" { $1 = ""; sub(/^ /, ""); print; exit }')
    if [ -n "$ssid" ]; then
        q=$(awk '$1 ~ /^wlan0/ { gsub(/\./, "", $3); printf "%d", $3 * 100 / 70 }' /proc/net/wireless)
        net="${C_NET}${I_NET}${NRM}  ${ssid}${q:+ ${q}%}"
    else
        net="${C_NET}${I_NET}${NRM}  --"
    fi

    if [ "$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null)" = "Mute: yes" ]; then
        vol="${C_VOL}${I_VOL}${NRM}  --"
    else
        vol="${C_VOL}${I_VOL}${NRM}  $(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk '{ print $5; exit }')"
        [ "$vol" = "${C_VOL}${I_VOL}${NRM}  " ] && vol="${C_VOL}${I_VOL}${NRM}  ?"
    fi

    # A field with no source on this machine contributes nothing, not even
    # its separator -- hence the ${x:+  $x} rather than a bare "$x".
    line=$(printf '%s  %s  %s  %s%%%s%s  %s' \
              "$vol" "$net" "${C_CPU}${I_CPU}${NRM}" "$cpu" \
              "${tmp:+  $tmp}" "${bat:+  $bat}" \
              "$(date '+%a %b %e %H:%M %Y')")

    if [ stdout = "$out" ]; then
        printf '%s\n' "$line" || exit
    else
        xprop -root -f WM_NAME 8s -set WM_NAME "$line" || exit
    fi

    sleep 5
done
